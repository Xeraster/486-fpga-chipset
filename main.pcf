set_io IOW 26
set_io SMEMR 28
set_io SMEMW 29
set_io MEMR 31
set_io MEMW 32
set_io BALE 33
set_io INTA 34

#timing related stuff
set_io SLOT_RDY 125 #v9958 wait signal
set_io RDY 23       #the regular RDY signal going to the cpu
#set_io CPU_CLK 94

#control the fpga's data bus
set_io ts_ctrl 135

#chip enable signals
set_io rom_en 55
set_io sram_en 7
set_io lcd_en 4
set_io PIT_en 48
set_io rtc_en 47
