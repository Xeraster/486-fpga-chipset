set_io vgamap_en 38
set_io cpld1_reg1_en 37

#reset signal coming from lm809 to the fpga
set_io FPGA_RESET 49

#reset signal the fpga send out to the system after its finished getting its shit together
set_io SYSTEM_RESET 93

#interrupt_debug
set_io interrupt_vector 120

